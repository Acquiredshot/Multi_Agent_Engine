      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(http_requests_total{job=\"fastapi\", status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=\"fastapi\"}[5m])), 0.0001)",
          "legendFormat": "5xx %",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
