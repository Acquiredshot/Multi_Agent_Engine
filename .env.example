# Copy to .env and edit. Git-ignored, never copied into the image.
#
# In containers this file is optional (`env_file: required: false`) and holds
# local overrides only: the REDIS_* values below are set in
# docker-compose.yml under `environment:`, which takes precedence, so nothing
# here can point a container at the wrong Redis or leak a credential into
# `docker inspect`.
#
# For running outside Docker, these values do apply.

APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# --- broker / result backend ---
# RabbitMQ is the Celery broker; Redis is the result backend.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD_FILE=secrets/rabbitmq_password

# "redis" resolves on the compose network; localhost for a non-Docker run.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
RESULT_BACKEND_DB=1

# Read from the same file compose mounts as a secret, so the password itself
# lives in exactly one place. Relative to the project root.
# Prefer this over REDIS_PASSWORD, which would put the value in this file.
REDIS_PASSWORD_FILE=secrets/redis_password

# --- ocr backend (strategy pattern) ---
# Selects the OCRBackend implementation AND the image dependency layer, since
# docker-compose.yml feeds this same value to the build arg.
#   stub      - default; extracts nothing, no dependencies
#   tesseract - local; needs the tesseract-ocr + poppler-utils system packages
#   textract  - AWS; needs boto3 and credentials
# Changing this requires a rebuild: docker compose up -d --build
OCR_BACKEND=tesseract

# Tesseract tuning (OCR_BACKEND=tesseract)
TESSERACT_LANG=eng
TESSERACT_DPI=200
TESSERACT_TIMEOUT_S=120

# Textract tuning (OCR_BACKEND=textract). Credentials come from the standard
# AWS chain, never from this file.
# TEXTRACT_REGION=us-east-1
# Multi-page PDF/TIFF is async and S3-only. Sources that are not already in
# S3 are staged here; without it such documents are rejected outright.
# TEXTRACT_STAGING_BUCKET=my-textract-staging

# --- worker behaviour ---
TASK_TIME_LIMIT_S=300
TASK_SOFT_TIME_LIMIT_S=240
TASK_MAX_RETRIES=3
TASK_RETRY_BACKOFF_S=5
